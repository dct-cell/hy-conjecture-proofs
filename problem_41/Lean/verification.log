def Problem41.IntegralOverIdeal.{u_1} : {R : Type u_1} → [inst : CommRing.{u_1} R] → Ideal.{u_1} R → R → Prop :=
fun {R} [CommRing.{u_1} R] I x =>
  ∃ p,
    Polynomial.Monic.{u_1} p ∧
      Eq.{u_1 + 1} (Polynomial.eval.{u_1} x p) 0 ∧
        ∀ (i : ℕ),
          Membership.mem.{u_1, u_1} (HPow.hPow.{u_1, 0, u_1} I (HSub.hSub.{0, 0, 0} (Polynomial.natDegree.{u_1} p) i))
            ((Polynomial.coeff.{u_1} p) i)
def Problem41.IntegrallyClosedIdeal.{u_1} : {R : Type u_1} → [inst : CommRing.{u_1} R] → Ideal.{u_1} R → Prop :=
fun {R} [CommRing.{u_1} R] I => ∀ (x : R), Problem41.IntegralOverIdeal.{u_1} I x → Membership.mem.{u_1, u_1} I x
def Problem41.pureIdeal.{u_1} : (k : Type u_1) →
  [inst : Field.{u_1} k] → ℕ → ℕ → ℕ → Ideal.{u_1} (MvPolynomial.{0, u_1} (Fin 3) k) :=
