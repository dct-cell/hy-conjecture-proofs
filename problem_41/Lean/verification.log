    (insert.{u_1, u_1} (HPow.hPow.{u_1, 0, u_1} (MvPolynomial.X.{u_1, 0} 0) a)
      (insert.{u_1, u_1} (HPow.hPow.{u_1, 0, u_1} (MvPolynomial.X.{u_1, 0} 1) b)
        (singleton.{u_1, u_1} (HPow.hPow.{u_1, 0, u_1} (MvPolynomial.X.{u_1, 0} 2) c))))
